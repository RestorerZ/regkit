            "hash": "8fc93445756c51b9445323b1708f3a4127ee8eedbd208d4ae85a5fbc64e6fb4d"
        },
        "32bit": {
            "url": "https://github.com/nohuto/regkit/releases/download/V1.1.3/RegKit-Portable-1.1.3-x86.zip",
            "hash": "bb72ddbb75e08303d498fa5327b33ddaed5bb74af62c1ca74148ee78e2d419fe"
        }
    },
    "bin": "regkit.exe",
    "shortcuts": [
        [
            "regkit.exe",
            "RegKit"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $executables = @(Join-Path $dir 'regkit.exe')",
            "    $current = Join-Path (Split-Path $dir) 'current\\regkit.exe'",
            "    if (Test-Path -LiteralPath $current) { $executables += $current }",
            "    foreach ($exe in $executables) {",
            "        foreach ($argument in '--uninstall-regedit-replacement', '--uninstall-edit-context-menu') {",
            "            $process = Start-Process -FilePath $exe -ArgumentList $argument -Wait -PassThru -WindowStyle Hidden -ErrorAction Stop",
            "            if ($process.ExitCode -ne 0) { abort \"RegKit cleanup failed ($argument)\" }",
            "        }",
            "    }",
            "}"
        ]
    },
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $dataDir = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'Noverse\\RegKit'",
        "    if (Test-Path -LiteralPath $dataDir) { Remove-Item -LiteralPath $dataDir -Recurse -Force -ErrorAction Stop }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nohuto/regkit/releases/download/V$version/RegKit-Portable-$version-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/nohuto/regkit/releases/download/V$version/RegKit-Portable-$version-x86.zip"
            }
        }
    }
}
