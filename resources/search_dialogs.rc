IDD_COMPARE DIALOGEX 0, 0, 560, 191
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Compare Registries"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "First Entry",IDC_STATIC,8,6,544,76
