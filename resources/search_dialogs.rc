IDD_COMPARE DIALOGEX 0, 0, 560, 159
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Compare Registries"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "First Entry",IDC_STATIC,8,6,544,58
    LTEXT           "Source:",IDC_STATIC,16,20,36,8
    COMBOBOX        IDC_COMPARE_LEFT_SOURCE,60,18,72,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "File:",IDC_COMPARE_LEFT_FILE_LABEL,16,33,40,8
    EDITTEXT        IDC_COMPARE_LEFT_FILE,60,31,411,11,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_COMPARE_LEFT_BROWSE,476,31,52,11
    LTEXT           "Key:",IDC_STATIC,16,46,22,8
    COMBOBOX        IDC_COMPARE_LEFT_KEY,60,44,410,120,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Recursive",IDC_COMPARE_LEFT_RECURSIVE,478,46,70,10

    GROUPBOX        "Second Entry",IDC_STATIC,8,67,544,58
    LTEXT           "Source:",IDC_STATIC,16,81,36,8
    COMBOBOX        IDC_COMPARE_RIGHT_SOURCE,60,79,72,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "File:",IDC_COMPARE_RIGHT_FILE_LABEL,16,94,40,8
    EDITTEXT        IDC_COMPARE_RIGHT_FILE,60,92,411,11,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_COMPARE_RIGHT_BROWSE,476,92,52,11
    LTEXT           "Key:",IDC_STATIC,16,107,22,8
    COMBOBOX        IDC_COMPARE_RIGHT_KEY,60,105,410,120,CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Recursive",IDC_COMPARE_RIGHT_RECURSIVE,478,107,70,10

    GROUPBOX        "Results",IDC_STATIC,8,128,184,24
    AUTORADIOBUTTON "Both",IDC_COMPARE_SHOW_BOTH,16,137,28,10,WS_GROUP
    AUTORADIOBUTTON "Only differences",IDC_COMPARE_SHOW_DIFFERENCES,52,137,64,10
    AUTORADIOBUTTON "Only matching",IDC_COMPARE_SHOW_MATCHING,124,137,60,10

    DEFPUSHBUTTON   "Compare",IDOK,462,141,45,11
    PUSHBUTTON      "Cancel",IDCANCEL,512,141,40,11
END
